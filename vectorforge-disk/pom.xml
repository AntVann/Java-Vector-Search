<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vectorforge</groupId>
        <artifactId>vectorforge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vectorforge-disk</artifactId>
    <name>VectorForge Disk IVF Prototype</name>
    <description>Experimental disk-backed IVF-style vector search.</description>

    <dependencies>
        <dependency>
            <groupId>com.vectorforge</groupId>
            <artifactId>vectorforge-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vectorforge</groupId>
            <artifactId>vectorforge-cpu</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
