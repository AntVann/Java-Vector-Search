<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vectorforge</groupId>
        <artifactId>vectorforge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vectorforge-native</artifactId>
    <name>VectorForge Native</name>
    <description>JNI-based native interoperability layer for VectorForge.</description>

    <properties>
        <vectorforge.native.library.name>vectorforge_jni</vectorforge.native.library.name>
        <vectorforge.native.build.dir>${project.build.directory}/cmake</vectorforge.native.build.dir>
        <vectorforge.native.output.dir>${project.build.directory}/native-lib</vectorforge.native.output.dir>
        <vectorforge.native.tests.enabled>${vectorforge.native.enabled}</vectorforge.native.tests.enabled>
        <vectorforge.native.cmake.enable_cuda>OFF</vectorforge.native.cmake.enable_cuda>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.vectorforge</groupId>
            <artifactId>vectorforge-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vectorforge</groupId>
            <artifactId>vectorforge-cpu</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <vectorforge.native.tests.enabled>${vectorforge.native.tests.enabled}</vectorforge.native.tests.enabled>
                        <vectorforge.native.library.dir>${vectorforge.native.output.dir}</vectorforge.native.library.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>configure-native-library</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument>
                                        <argument>${project.basedir}</argument>
                                        <argument>-B</argument>
                                        <argument>${vectorforge.native.build.dir}</argument>
                                        <argument>-G</argument>
                                        <argument>MinGW Makefiles</argument>
                                        <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                        <argument>-DOUTPUT_DIR=${vectorforge.native.output.dir}</argument>
                                        <argument>-DVECTORFORGE_ENABLE_CUDA=${vectorforge.native.cmake.enable_cuda}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>build-native-library</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>--build</argument>
                                        <argument>${vectorforge.native.build.dir}</argument>
                                        <argument>--config</argument>
                                        <argument>Release</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cuda</id>
            <properties>
                <vectorforge.native.cmake.enable_cuda>ON</vectorforge.native.cmake.enable_cuda>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>configure-native-library-cuda</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument>
                                        <argument>${project.basedir}</argument>
                                        <argument>-B</argument>
                                        <argument>${vectorforge.native.build.dir}</argument>
                                        <argument>-G</argument>
                                        <argument>MinGW Makefiles</argument>
                                        <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                        <argument>-DOUTPUT_DIR=${vectorforge.native.output.dir}</argument>
                                        <argument>-DVECTORFORGE_ENABLE_CUDA=ON</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>build-native-library-cuda</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>--build</argument>
                                        <argument>${vectorforge.native.build.dir}</argument>
                                        <argument>--config</argument>
                                        <argument>Release</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
